<section class="cta-band">
  <div class="container cta-band-inner">
    <div>
      <p class="eyebrow">Start your project</p>
      <h2>Let's design your dream space, together.</h2>
    </div>
    <a href="/contact" class="btn btn-light">Get Free Consultation <i class="fa-solid fa-arrow-right"></i></a>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="{{business.name}} home">
        <img class="brand-mark" src="/images/logo.svg" width="40" height="40" alt="" aria-hidden="true">
        <span class="brand-text">
          <span class="brand-line1">FOREVER<br><strong>DREAM SPACES</strong></span>
          <span class="brand-line2">— Interior Design —</span>
        </span>
      </a>
      <p>Crafting warm, functional and beautiful residential &amp; commercial interiors across Delhi NCR.</p>
      <div class="social-links">
        <a href="{{business.social.instagram}}" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="{{business.social.facebook}}" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="{{business.social.linkedin}}" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        <a href="{{business.social.youtube}}" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/services/residential-interior-design">Residential Design</a></li>
        <li><a href="/services/commercial-interior-design">Commercial Design</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href="/services/residential-interior-design">Living Room Design</a></li>
        <li><a href="/services/residential-interior-design">Kitchen &amp; Bedroom</a></li>
        <li><a href="/services/commercial-interior-design">Office Interiors</a></li>
        <li><a href="/services/commercial-interior-design">Retail &amp; Hospitality</a></li>
      </ul>
    </div>

    <div class="footer-col footer-contact">
      <h4>Get in Touch</h4>
      <ul>
        <li><i class="fa-solid fa-location-dot"></i> {{business.addressFull}}</li>
        <li><i class="fa-solid fa-envelope"></i> <a href="mailto:{{business.email}}">{{business.email}}</a></li>
        <li><i class="fa-solid fa-phone"></i> <a href="tel:{{business.phone}}">{{business.phone}}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {{year}} {{business.name}}. All rights reserved.</p>
    <p>Designed with care for beautiful interiors.</p>
  </div>
  <div class="container footer-credit">
    <p>Created by <a href="https://nexmogen.com/" target="_blank" rel="noopener" class="credit-link">Nexmogen</a></p>
  </div>
</footer>

<a class="float-btn whatsapp" href="https://wa.me/{{business.whatsapp}}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <i class="fa-brands fa-whatsapp"></i>
</a>
<a class="float-btn call" href="tel:{{business.phone}}" aria-label="Call us">
  <i class="fa-solid fa-phone"></i>
</a>
