<section class="hero page-hero">
  <div class="hero-bg" style="background-image:url('{{image}}')"></div>
  <div class="container hero-content">
    <div class="breadcrumb"><a href="/">Home</a> <i class="fa-solid fa-chevron-right" style="font-size:10px"></i> <span>{{crumb}}</span></div>
    {{#if eyebrow}}<p class="eyebrow">{{eyebrow}}</p>{{/if}}
    <h1>{{heading}}</h1>
    {{#if subtitle}}<p class="lead">{{subtitle}}</p>{{/if}}
  </div>
</section>
