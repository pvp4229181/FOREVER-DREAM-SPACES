<!DOCTYPE html>
<html lang="en">
<head>{{> head}}</head>
<body>
{{> nav}}

{{> page-hero image=img.heroContact crumb="Contact Us" eyebrow="Get In Touch" heading="Let's talk about your space" subtitle="Tell us a little about your project and our design team will get back to you within 24 hours."}}

<section>
  <div class="container two-col" style="align-items:flex-start">
    <div class="reveal">
      <form data-ajax-contact action="/contact" method="POST" class="form-card">
        <h3>Request a Free Consultation</h3>
        <div class="form-row">
          <div class="field">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required>
          </div>
          <div class="field">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="+91 00000 00000">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>
          </div>
          <div class="field">
            <label for="service">I'm interested in</label>
            <select id="service" name="service">
              <option value="Residential Interior Design">Residential Interior Design</option>
              <option value="Commercial Interior Design">Commercial Interior Design</option>
              <option value="Space Planning & 3D Design">Space Planning &amp; 3D Design</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="city">City</label>
          <input type="text" id="city" name="city" placeholder="e.g. Greater Noida West">
        </div>
        <div class="field">
          <label for="message">Tell us about your project</label>
          <textarea id="message" name="message" rows="4" placeholder="Property type, size, timeline..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send Message <i class="fa-solid fa-paper-plane"></i></button>
        <div class="form-status"></div>
        <p class="form-note">By submitting, you agree to be contacted by our design team regarding your enquiry.</p>
      </form>
    </div>

    <div class="reveal">
      <p class="eyebrow">Contact Information</p>
      <h2>We'd love to hear from you</h2>
      <ul class="contact-info-list">
        <li>
          <div class="icn"><i class="fa-solid fa-location-dot"></i></div>
          <div><h4>Our Office</h4><p>{{business.addressFull}}</p></div>
        </li>
        <li>
          <div class="icn"><i class="fa-solid fa-envelope"></i></div>
          <div><h4>Email Us</h4><p><a href="mailto:{{business.email}}">{{business.email}}</a></p></div>
        </li>
        <li>
          <div class="icn"><i class="fa-solid fa-phone"></i></div>
          <div><h4>Call Us</h4><p><a href="tel:{{business.phone}}">{{business.phone}}</a></p></div>
        </li>
        <li>
          <div class="icn"><i class="fa-brands fa-whatsapp"></i></div>
          <div><h4>WhatsApp</h4><p><a href="https://wa.me/{{business.whatsapp}}" target="_blank" rel="noopener">Chat with us</a></p></div>
        </li>
      </ul>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps?q=NXONE+Tower+Greater+Noida+West&output=embed"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Office location map"></iframe>
      </div>
    </div>
  </div>
</section>

{{> footer}}
<script src="/js/main.js"></script>
</body>
</html>
