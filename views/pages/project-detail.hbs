<!DOCTYPE html>
<html lang="en">
<head>{{> head}}</head>
<body>
{{> nav}}

{{> page-hero image=project.image crumb=project.title eyebrow=project.category heading=project.title subtitle=project.desc}}

<section>
  <div class="container two-col">
    <div class="reveal">
      <img src="{{project.image}}" alt="{{project.title}}" style="border-radius:var(--radius-lg);box-shadow:var(--shadow-soft)" loading="lazy">
    </div>
    <div class="reveal">
      <p class="eyebrow">Project Overview</p>
      <h2>{{project.title}}</h2>
      <p>{{project.desc}}</p>
      <ul class="check-list">
        <li><i class="fa-solid fa-location-dot"></i> {{project.location}}</li>
        <li><i class="fa-solid fa-layer-group"></i> {{project.category}} Interior Design</li>
        <li><i class="fa-solid fa-circle-check"></i> Full design &amp; turnkey execution</li>
      </ul>
      <a href="/contact" class="btn btn-primary" style="margin-top:10px">Start a Similar Project <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

<section style="background:var(--paper-alt)">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow" style="justify-content:center">More Work</p>
      <h2>Related Projects</h2>
    </div>
    <div class="grid-3">
      {{#each related}}
      <a href="/projects/{{slug}}" class="project-card reveal">
        <img src="{{image}}" alt="{{title}}" loading="lazy">
        <div class="overlay">
          <span class="tag">{{category}}</span>
          <h3>{{title}}</h3>
          <span class="loc"><i class="fa-solid fa-location-dot"></i> {{location}}</span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

{{> footer}}
<script src="/js/main.js"></script>
</body>
</html>
