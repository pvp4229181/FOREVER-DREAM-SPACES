<!DOCTYPE html>
<html lang="en">
<head>{{> head}}</head>
<body>
{{> nav}}

{{> page-hero image=img.heroProjects crumb="Services" eyebrow="What We Do" heading="Interior design services for every space" subtitle="From a single room refresh to a full commercial fit-out, our services cover the entire design and build journey."}}

<section>
  <div class="container grid-3">
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-couch"></i></div>
      <h3>Residential Interior Design</h3>
      <p>Living rooms, bedrooms, kitchens, kids' rooms and full-home interiors tailored to your lifestyle and budget.</p>
      <a href="/services/residential-interior-design" class="more">Learn More <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-building"></i></div>
      <h3>Commercial Interior Design</h3>
      <p>Offices, retail stores, cafés and hospitality interiors designed for brand identity and everyday performance.</p>
      <a href="/services/commercial-interior-design" class="more">Learn More <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-drafting-compass"></i></div>
      <h3>Space Planning &amp; 3D Visualisation</h3>
      <p>Detailed layouts and photorealistic renders so you can see, adjust and approve your design before execution.</p>
      <a href="/contact" class="more">Get In Touch <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-palette"></i></div>
      <h3>Turnkey Execution</h3>
      <p>Civil work, false ceiling, electrical, painting, furniture and styling — managed under one roof.</p>
      <a href="/contact" class="more">Get In Touch <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-lightbulb"></i></div>
      <h3>Lighting Design</h3>
      <p>Layered lighting plans that shape mood, function and the character of every room.</p>
      <a href="/contact" class="more">Get In Touch <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="service-card reveal">
      <div class="icon"><i class="fa-solid fa-swatchbook"></i></div>
      <h3>Furniture &amp; Décor Styling</h3>
      <p>Curated furniture, soft furnishings and accessories that complete the story of your space.</p>
      <a href="/contact" class="more">Get In Touch <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>
</section>

{{> footer}}
<script src="/js/main.js"></script>
</body>
</html>
