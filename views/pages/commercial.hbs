<!DOCTYPE html>
<html lang="en">
<head>{{> head}}</head>
<body>
{{> nav}}

{{> page-hero image=img.heroCommercial crumb="Commercial Interior Design" eyebrow="Commercial Interior Design" heading="Spaces engineered for your brand" subtitle="Offices, retail stores and hospitality interiors designed to boost productivity, reflect your brand and welcome every visitor."}}

<section>
  <div class="container two-col">
    <div class="reveal">
      <div class="about-media">
        <img src="{{img.gallery.[1]}}" alt="Commercial office interior" loading="lazy">
      </div>
    </div>
    <div class="reveal">
      <p class="eyebrow">Commercial Interior Design</p>
      <h2>Design that works as hard as your business does</h2>
      <p>A commercial space needs to do more than look good — it needs to support the people who work in it and the customers who walk through the door. We design offices, retail environments and hospitality spaces that balance brand identity, functionality and comfort.</p>
      <p>Our process covers space planning, acoustics, lighting, furniture and material selection, all coordinated with your operational needs and timelines.</p>
      <ul class="check-list">
        <li><i class="fa-solid fa-circle-check"></i> Corporate offices &amp; co-working spaces</li>
        <li><i class="fa-solid fa-circle-check"></i> Retail stores &amp; showrooms</li>
        <li><i class="fa-solid fa-circle-check"></i> Cafés, restaurants &amp; hospitality</li>
        <li><i class="fa-solid fa-circle-check"></i> Reception, cabins &amp; meeting rooms</li>
      </ul>
    </div>
  </div>
</section>

<section style="background:var(--paper-alt)">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow" style="justify-content:center">Why It Matters</p>
      <h2>Good design is good business</h2>
    </div>
    <div class="value-grid">
      <div class="value-tile reveal"><i class="fa-solid fa-people-group"></i><h4>Productivity</h4><p>Layouts and acoustics that help teams focus and collaborate.</p></div>
      <div class="value-tile reveal"><i class="fa-solid fa-star"></i><h4>Brand Identity</h4><p>Interiors that visually reinforce who you are as a business.</p></div>
      <div class="value-tile reveal"><i class="fa-solid fa-user-check"></i><h4>Client Experience</h4><p>Spaces that make customers and visitors feel welcome.</p></div>
      <div class="value-tile reveal"><i class="fa-solid fa-gauge-high"></i><h4>Efficient Delivery</h4><p>Project management that respects your business timelines.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head reveal" style="max-width:none;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px">
      <div><p class="eyebrow">Recent Work</p><h2>Commercial projects</h2></div>
      <a href="/projects" class="btn btn-outline">View All Projects</a>
    </div>
    <div class="grid-3">
      {{#each projects}}
      <a href="/projects/{{slug}}" class="project-card reveal">
        <img src="{{image}}" alt="{{title}}" loading="lazy">
        <div class="overlay">
          <span class="tag">{{category}}</span>
          <h3>{{title}}</h3>
          <span class="loc"><i class="fa-solid fa-location-dot"></i> {{location}}</span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

{{> footer}}
<script src="/js/main.js"></script>
</body>
</html>
